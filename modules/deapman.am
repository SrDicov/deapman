#!/usr/bin/env bash
# deapman.am — native deapman commands: install/run/list/info/remove/update/dedup/verify/gc
# for locally-registered AppImages with content-hash dedup.
# Upstream DB/launcher flows are delegated back to database.am / install.am /
# management.am / _use_update so this module only owns $DEAPMAN_HOME natives.
# License: GPL-3.0-or-later (fork of ivan-hc/AM).

# ---------- environment ----------
DEAPMAN_HOME="${DEAPMAN_HOME:-${DAP_HOME:-$DATADIR/deapman}}"
DEAPMAN_APPS="$DEAPMAN_HOME/apps"
DEAPMAN_ORIG="$DEAPMAN_HOME/originals"
DEAPMAN_COMMON="$DEAPMAN_HOME/common"
DEAPMAN_CACHE="$DEAPMAN_HOME/cache"
DEAPMAN_TMP="$DEAPMAN_HOME/tmp"
DEAPMAN_CACHE_TTL_DAYS="${DEAPMAN_CACHE_TTL_DAYS:-7}"

_deapman_ensure_dirs() {
	mkdir -p "$DEAPMAN_APPS" "$DEAPMAN_ORIG" "$DEAPMAN_COMMON" "$DEAPMAN_CACHE" "$DEAPMAN_TMP" "$BINDIR" || {
		echo "deapman: error: cannot create directories in $DEAPMAN_HOME" >&2
		return 1
	}
}

_deapman_err() { echo "deapman: error: $*" >&2; }
_deapman_note() { echo "deapman: $*" >&2; }

# _deapman_appdir <name|nick> → prints apps/<name> dir, 0 on exact match.
_deapman_appdir() {
	[ -n "$1" ] || return 1
	[ -d "$DEAPMAN_APPS/$1" ] && { printf '%s' "$DEAPMAN_APPS/$1"; return 0; }
	for m in "$DEAPMAN_APPS"/*/manifest; do
		[ -f "$m" ] || continue
		# shellcheck disable=SC1090
		if ( unset nick name; . "$m"; [ "${nick:-}" = "$1" ] ); then
			printf '%s' "$(dirname "$m")"
			return 0
		fi
	done
	return 1
}

_deapman_is_native() { _deapman_appdir "$1" >/dev/null 2>&1; }

_deapman_app_field() { # <appdir> <field> → value
	# shellcheck disable=SC1090
	( unset name nick version origin mode thin sha_orig updated; . "$1/manifest"; eval "printf '%s' \"\${$2:-}\"" )
}

# ---------- install ----------
# deapman install <ruta|url> <nombre> [apodo]
_deapman_install() {
	_src="$1"; _name="$2"; _nick="${3:-$2}"
	[ -n "$_src" ] && [ -n "$_name" ] || { _deapman_err "uso: deapman install <ruta|url> <nombre> [apodo]"; return 2; }
	case "$_name" in
		*[^a-z0-9+._-]*|"") _deapman_err "nombre inválido: $_name (solo [a-z0-9+._-])"; return 2 ;;
	esac
	_deapman_ensure_dirs || return 1
	if [ -d "$DEAPMAN_APPS/$_name" ]; then _deapman_err "$_name ya está instalado (usa: deapman update $_name)"; return 1; fi
	for m in "$DEAPMAN_APPS"/*/manifest; do
		[ -f "$m" ] || continue
		# shellcheck disable=SC1090
		if ( unset nick; . "$m"; [ "${nick:-}" = "$_nick" ] ); then
			_deapman_err "apodo '$_nick' ya en uso"; return 1
		fi
	done
	_file=""
	case "$_src" in
		http://*|https://*)
			_file="$DEAPMAN_CACHE/$_name-$(basename "$_src")"
			_deapman_note "descargando $_src..."
			curl -fSL --retry 3 -C - -o "$_file" "$_src" || { _deapman_err "descarga fallida"; return 4; }
			;;
		*)
			[ -f "$_src" ] || { _deapman_err "no existe: $_src"; return 1; }
			_file="$_src"
			;;
	esac
	if ! head -c10 "$_file" 2>/dev/null | grep -qa '^.ELF....AI$' 2>/dev/null; then
		_deapman_err "\"$_src\" no es un AppImage (magia ELF+AI ausente)"
		return 1
	fi
	chmod +x "$_file"
	mkdir -p "$DEAPMAN_ORIG/$_name" "$DEAPMAN_APPS/$_name" || return 1
	_dest="$DEAPMAN_ORIG/$_name/app.orig.AppImage"
	cp -f "$_file" "$_dest" || return 1
	chmod a-w "$_dest"
	_sha=$(sha256sum "$_dest" | awk '{print $1}')
	cat >"$DEAPMAN_APPS/$_name/manifest" <<EOF
name='$_name'
nick='$_nick'
version='unknown'
origin='$_src'
mode='orig'
thin='0'
sha_orig='$_sha'
updated='$(date +%F)'
EOF
	chmod a-w "$DEAPMAN_APPS/$_name/manifest" 2>/dev/null || true
	_deapman_mkshim "$_name" "$_nick"
	_deapman_mkdesktop "$_name" "$_dest"
	chmod u+w "$DEAPMAN_APPS/$_name/manifest"
	printf 'instalado %s (%s)%s\n' "$_name" "$_nick" ""
	chmod a-w "$DEAPMAN_APPS/$_name/manifest" 2>/dev/null || true
	return 0
}

_deapman_mkshim() { # <name> <nick>
	for _b in "$1" "$2"; do
		[ -n "$_b" ] || continue
		cat >"$BINDIR/$_b" <<EOF
#!/bin/sh
# Generated by deapman for '$1'. Do not edit.
exec deapman run '$1' "\$@"
EOF
		chmod +x "$BINDIR/$_b"
	done
}

_deapman_mkdesktop() { # <name> <appimage>
	# NOTA: el runtime AppImage solo honra el PRIMER patrón de
	# --appimage-extract por invocación: un patrón por llamada.
	_t=$(mktemp -d "$DEAPMAN_TMP/desk-XXXXXX" 2>/dev/null) || return 0
	( cd "$_t" && "$2" --appimage-extract '*.desktop' >/dev/null 2>&1 )
	( cd "$_t" && "$2" --appimage-extract '.DirIcon' >/dev/null 2>&1 )
	( cd "$_t" && "$2" --appimage-extract '*.png' >/dev/null 2>&1 )
	_desk=$(find "$_t" -maxdepth 3 -name '*.desktop' 2>/dev/null | head -1)
	[ -n "$_desk" ] || { rm -rf "$_t"; return 0; }
	_ddir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
	mkdir -p "$_ddir" "$DATADIR/icons"
	_icon=$(find "$_t" -maxdepth 2 -name '.DirIcon' 2>/dev/null | head -1)
	[ -z "$_icon" ] && _icon=$(find "$_t" -maxdepth 3 -path '*hicolor*apps*.png' 2>/dev/null | sort -r | head -1)
	[ -z "$_icon" ] && _icon=$(find "$_t" -maxdepth 2 -name '*.png' 2>/dev/null | head -1)
	_iconf=""
	if [ -n "$_icon" ] && cp -f "$_icon" "$DATADIR/icons/$1" 2>/dev/null; then
		_iconf="$DATADIR/icons/$1"
		# Extensión según contenido (algunos lanzadores la exigen)
		if head -c 4 "$_iconf" 2>/dev/null | grep -q 'PNG'; then
			mv -f "$_iconf" "$_iconf.png" 2>/dev/null && _iconf="$_iconf.png"
		elif head -c 200 "$_iconf" 2>/dev/null | grep -qi 'svg'; then
			mv -f "$_iconf" "$_iconf.svg" 2>/dev/null && _iconf="$_iconf.svg"
		fi
	fi
	_main=$(grep -m1 '^Exec=' "$_desk" | cut -d= -f2- | awk '{print $1}' | xargs basename 2>/dev/null)
	{ grep -v '^Exec=\|^TryExec=\|^Icon=' "$_desk";
	  printf 'Exec=%s/%s %%U\n' "$BINDIR" "$1";
	  printf 'TryExec=%s/%s\n' "$BINDIR" "$1";
	  [ -n "$_iconf" ] && [ -f "$_iconf" ] && printf 'Icon=%s\n' "$_iconf";
	} >"$_ddir/$1-deapman.desktop"
	rm -rf "$_t"
	return 0
}

# ---------- run ----------
_deapman_run() { # <name|nick> [args...]
	_app="$1"; shift
	_d=$(_deapman_appdir "$_app") || { _deapman_err "\"$_app\" no instalado (deapman list)"; return 3; }
	_img="$_d/app.thin.AppImage"
	[ -x "$_img" ] || _img="$DEAPMAN_ORIG/$(basename "$_d")/app.orig.AppImage"
	[ -x "$_img" ] || { _deapman_err "AppImage ausente para $(basename "$_d")"; return 1; }
	unset LD_LIBRARY_PATH GCONV_PATH GDK_PIXBUF_MODULE_FILE 2>/dev/null || true
	exec "$_img" "$@"
}

# ---------- list / info ----------
_deapman_list_native() {
	_n=0
	for m in "$DEAPMAN_APPS"/*/manifest; do
		[ -f "$m" ] || continue
		# shellcheck disable=SC1090
		( unset name nick version mode thin; . "$m"
		  printf '%s (%s)  %s  [%s]%s\n' "${name:-?}" "${nick:-?}" "${version:-?}" "${mode:-?}" \
		    "$([ "${thin:-0}" = 1 ] && printf ' thin' || printf '')" )
		_n=$((_n+1))
	done
	[ "$_n" -eq 0 ] && _deapman_note "sin apps deapman nativas"
	return 0
}

_deapman_info() { # <name|nick>
	_d=$(_deapman_appdir "$1") || { _deapman_err "\"$1\" no instalado"; return 3; }
	# shellcheck disable=SC1090
	( unset name nick version origin mode thin sha_orig updated; . "$_d/manifest"
	  printf 'nombre:      %s\napodo:       %s\nversión:     %s\norigen:      %s\nmodo:        %s\nadelgazado:  %s\nsha256:      %.16s…\nactualizado: %s\n' \
	    "${name:-?}" "${nick:-?}" "${version:-?}" "${origin:-?}" "${mode:-?}" \
	    "$([ "${thin:-0}" = 1 ] && printf 'sí' || printf 'no')" "${sha_orig:-?}" "${updated:-?}" )
	_img="$_d/app.thin.AppImage"; [ -x "$_img" ] || _img="$DEAPMAN_ORIG/$1/app.orig.AppImage"
	[ -f "$_img" ] && printf 'tamaño:      %s\n' "$(du -h "$_img" | cut -f1)"
	return 0
}

# ---------- remove ----------
_deapman_remove() { # [-f] <name|nick>...
	_force=0; [ "$1" = "-f" ] && { _force=1; shift; }
	for _a in "$@"; do
		_d=$(_deapman_appdir "$_a" 2>/dev/null) || continue
		_n=$(basename "$_d")
		if [ "$_force" -eq 0 ]; then
			printf 'desinstalar %s? (y,N) ' "$_n"
			read -r _yn || _yn="n"
			case "$_yn" in y|Y) ;; *) echo "omitido $_n"; continue ;; esac
		fi
		_nick=$(_deapman_app_field "$_d" nick)
		rm -rf "$_d" "$DEAPMAN_ORIG/$_n"
		rm -f "$BINDIR/$_n" "$BINDIR/$_nick"
		rm -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$_n-deapman.desktop"
		printf 'desinstalado %s (blobs comunes intactos; ejecuta `deapman gc`)\n' "$_n"
	done
	return 0
}

# ---------- update ----------
# deapman update [nombre|apodo [nuevo-archivo|nueva-url]] (sin nombre = todo)
_deapman_update_one() { # <name> [new-src]
	_d=$(_deapman_appdir "$1") || { _deapman_err "\"$1\" no instalado (¿quisiste `deapman install`?)"; return 3; }
	_n=$(basename "$_d")
	_new="${2:-}"
	[ -n "$_new" ] || _new=$(_deapman_app_field "$_d" origin)
	case "$_new" in
		http://*|https://*)
			_f="$DEAPMAN_CACHE/$_n-update-$(basename "$_new")"
			_got_delta=0; _z=""
			# Delta zsync si la herramienta existe (fork pkgforge appimageupdatetool):
			# actualiza una COPIA del original; si falla, descarga completa.
			if command -v appimageupdatetool >/dev/null 2>&1 && [ -f "$DEAPMAN_ORIG/$_n/app.orig.AppImage" ]; then
				_deapman_note "probando delta zsync para $_n..."
				_z="$DEAPMAN_TMP/zsync-$$-$_n"; rm -rf "$_z"; mkdir -p "$_z" || return 1
				cp -f "$DEAPMAN_ORIG/$_n/app.orig.AppImage" "$_z/cand.AppImage" || return 1
				if appimageupdatetool "$_z/cand.AppImage" >/dev/null 2>&1; then
					_f="$_z/cand.AppImage"; _got_delta=1
					_deapman_note "delta zsync aplicado"
				else
					_deapman_note "sin delta disponible, descarga completa"
					rm -rf "$_z"; _z=""
				fi
			fi
			if [ "$_got_delta" -eq 0 ]; then
				_deapman_note "descargando actualización de $_n..."
				curl -fSL --retry 3 -C - -o "$_f" "$_new" || { _deapman_err "descarga fallida"; return 4; }
			fi
			;;
		"")
			_deapman_err "$_n sin origen recordado: indica ruta o URL (deapman update $_n <archivo|url>)"
			return 2
			;;
		*)
			[ -f "$_new" ] || { _deapman_err "no existe: $_new"; return 1; }
			_f="$_new"
			;;
	esac
	if ! head -c10 "$_f" 2>/dev/null | grep -qa '^.ELF....AI$' 2>/dev/null; then
		_deapman_err "el reemplazo no es un AppImage válido"; return 1
	fi
	_nsha=$(sha256sum "$_f" | awk '{print $1}')
	_osha=$(_deapman_app_field "$_d" sha_orig)
	if [ "$_nsha" = "$_osha" ]; then _deapman_note "$_n ya está al día"; return 0; fi
	_nick=$(_deapman_app_field "$_d" nick)
	_mode=$(_deapman_app_field "$_d" mode)
	cp -f "$_f" "$DEAPMAN_ORIG/$_n/app.orig.AppImage" || return 1
	[ -n "${_z:-}" ] && rm -rf "$_z"
	chmod a-w "$DEAPMAN_ORIG/$_n/app.orig.AppImage"
	rm -f "$_d/app.thin.AppImage"
	chmod u+w "$DEAPMAN_APPS/$_n/manifest"
	# shellcheck disable=SC1090
	( unset nick; . "$_d/manifest"
	  cat >"$_d/manifest" <<EOF
name='$_n'
nick='$_nick'
version='unknown'
origin='$_new'
mode='orig'
thin='0'
sha_orig='$_nsha'
updated='$(date +%F)'
EOF
	)
	chmod a-w "$_d/manifest" 2>/dev/null || true
	if [ "$_mode" = "symlink" ] || [ "$_mode" = "wrapper" ]; then
		# Re-thin automático con el mismo modo (usa el binario en uso).
		_flag="-s"; [ "$_mode" = "wrapper" ] && _flag="-w"
		_deapman_note "re-adelgazando $_n (modo $_mode)..."
		if [ -x "$AMCLIPATH" ]; then
			"$AMCLIPATH" dedup "$_flag" "$_n" || _deapman_note "re-thin falló: $_n queda usable sin adelgazar"
		else
			_deapman_note "no se halló $AMCLIPATH: re-ejecuta \`deapman dedup $_flag $_n\`"
		fi
	fi
	printf 'actualizado %s\n' "$_n"
	return 0
}

# ---------- verify ----------
# (inventory vive en deapman-dedup.am)
_deapman_verify() { # <name|nick>
	_d=$(_deapman_appdir "$1") || { _deapman_err "\"$1\" no instalado"; return 3; }
	_n=$(basename "$_d")
	_bad=0
	_img="$_d/app.thin.AppImage"; [ -f "$_img" ] || _img="$DEAPMAN_ORIG/$_n/app.orig.AppImage"
	[ -f "$_img" ] || { _deapman_err "$_n: AppImage ausente"; return 1; }
	head -c10 "$_img" 2>/dev/null | grep -qa '^.ELF....AI$' 2>/dev/null \
		&& echo "ok      magia AppImage" || { echo "FALTA    magia AppImage"; _bad=1; }
	if [ -f "$DEAPMAN_ORIG/$_n/app.orig.AppImage" ]; then
		_got=$(sha256sum "$DEAPMAN_ORIG/$_n/app.orig.AppImage" | awk '{print $1}')
		_exp=$(_deapman_app_field "$_d" sha_orig)
		[ "$_got" = "$_exp" ] && echo "ok      sha256 original" \
			|| { echo "FALTA    sha256 original (corrupto o manipulado)"; _bad=1; }
	fi
	[ -x "$BINDIR/$_n" ] && echo "ok      shim $BINDIR/$_n" \
		|| { echo "FALTA    shim $BINDIR/$_n"; _bad=1; }
	[ "$_bad" -eq 0 ] && printf 'verificado %s: íntegro\n' "$_n"
	return "$_bad"
}

# ---------- gc ----------
_deapman_gc() { # [--aggressive]
	_agg=0; [ "$1" = "--aggressive" ] && _agg=1
	_deapman_ensure_dirs || return 1
	# refs vivas: hashes citados en manifests (campo refs, lo puebla dedup)
	_t="$DEAPMAN_TMP/gc-$$"; rm -rf "$_t"; mkdir -p "$_t" || return 1
	: >"$_t/ref"
	for m in "$DEAPMAN_APPS"/*/manifest; do
		[ -f "$m" ] || continue
		# shellcheck disable=SC1090
		( unset refs; . "$m"; printf '%s' "${refs:-}" | tr ' ' '\n' ) >>"$_t/ref"
	done
	sort -u "$_t/ref" -o "$_t/ref.u" 2>/dev/null || : >"$_t/ref.u"
	_n=0; _freed=0
	if [ -d "$DEAPMAN_COMMON" ]; then
		while IFS= read -r _f; do
			[ -f "$_f" ] || continue
			_h=$(basename "$_f")
			if ! grep -qx "$_h" "$_t/ref.u" 2>/dev/null; then
				_s=$(wc -c <"$_f" | tr -d ' '); rm -f "$_f"
				_n=$((_n+1)); _freed=$((_freed+_s))
			fi
		done <<EOF
$(find "$DEAPMAN_COMMON" -type f 2>/dev/null)
EOF
		find "$DEAPMAN_COMMON" -mindepth 1 -type d -empty -delete 2>/dev/null || true
	fi
	# staging y temporales: siempre
	rm -rf "$DEAPMAN_TMP"/inv-* "$DEAPMAN_TMP"/desk-* "$DEAPMAN_TMP"/gc-* \
		"$DEAPMAN_TMP"/thin-* "$DEAPMAN_TMP"/zsync-* 2>/dev/null || true
	# caché: TTL normal, todo con --aggressive
	if [ "$_agg" -eq 1 ]; then
		rm -f "$DEAPMAN_CACHE"/* 2>/dev/null || true
		rm -rf "$AMCACHEDIR" 2>/dev/null; mkdir -p "$AMCACHEDIR"
	else
		find "$DEAPMAN_CACHE" -type f -mtime +"$DEAPMAN_CACHE_TTL_DAYS" -delete 2>/dev/null || true
	fi
	rm -rf "$_t"
	printf 'gc: %s blobs huérfanos borrados, %s bytes liberados%s\n' "$_n" "$_freed" \
		"$([ "$_agg" -eq 1 ] && printf ' (agresivo: caché vaciada)' || printf '')"
	return 0
}

# ---------- dispatch ----------
# (dedup/thin viven en deapman-dedup.am)
case "$1" in
	'install'|'-i')
		shift
		# Ruta/URL (+nombre) o pinta de ruta → nativo; si no, delega a install.am (DB).
		if [ $# -eq 0 ]; then
			_deapman_err "uso: deapman install <ruta|url> <nombre> [apodo]  |  deapman install <programa-DB>"
			exit 2
		elif [ -n "${2:-}" ] || [ -f "$1" ] || case "$1" in http://*|https://*|*/*|*.AppImage|*.appimage) true;; *) false;; esac; then
			_deapman_install "$@"
			exit $?
		else
			MODULE="install.am"
			_use_module install "$@"
		fi
		;;
	'run')
		shift
		[ $# -ge 1 ] || { _deapman_err "uso: deapman run <nombre|apodo> [args...]"; exit 2; }
		_deapman_run "$@"
		;;
	'__run_shortcut')
		shift
		if _deapman_is_native "${1:-}" 2>/dev/null; then
			_deapman_run "$@"
		elif [ -n "${1:-}" ] && [ -x "$BINDIR/$1" ]; then
			exec "$BINDIR/$1" "${@:2}"
		else
			echo "$DIVIDING_LINE"
			echo $"ERROR: unknown option \"$1\", run the \"$AMCLI -h\" command to find out more" | _fit
			echo "$DIVIDING_LINE"
			exit 2
		fi
		;;
	'list'|'-l')
		_deapman_ensure_dirs
		echo "== deapman natives =="
		_deapman_list_native
		MODULE="database.am"
		_use_module "$@"
		;;
	'info')
		shift
		[ $# -ge 1 ] || { _deapman_err "uso: deapman info <nombre|apodo>"; exit 2; }
		if _deapman_is_native "$1"; then
			_deapman_info "$1"
		elif ! _online_check_tool 2>/dev/null; then
			_deapman_err "\"$1\" no instalado y sin red para buscar en la DB"
			exit 3
		else
			MODULE="database.am"
			_use_module about "$@"
		fi
		;;
	'remove'|'-R'|'-r')
		_cmd="$1"; shift
		_force=""; [ "${1:-}" = "-f" ] && { _force="-f"; shift; }
		_native=""; _rest=""
		for _a in "$@"; do
			if _deapman_is_native "$_a"; then _native="$_native $_a"; else _rest="$_rest $_a"; fi
		done
		if [ -n "$_native" ]; then
			# shellcheck disable=SC2086
			if [ "$_cmd" = "-R" ] || [ -n "$_force" ]; then _deapman_remove -f $_native; else _deapman_remove $_native; fi
		fi
		if [ -n "$_rest" ]; then
			MODULE="management.am"
			# shellcheck disable=SC2086
			_use_module "$_cmd" $_rest
		fi
		;;
	'update'|'upgrade'|'-u'|'-U')
		shift
		if [ $# -eq 0 ]; then
			for _d in "$DEAPMAN_APPS"/*; do
				[ -d "$_d" ] || continue
				_deapman_update_one "$(basename "$_d")" || true
			done
			_use_update update
		else
			# Contrato: update <nombre> [nuevo] | update <n1> <n2>… | update (todo).
			# Si el último posicional es ruta/URL y hay un nativo antes → es new-src
			# del PRIMER nativo; el resto de posicionales deben ser flags.
			_rest=""; _pos=""
			for _a in "$@"; do
				case "$_a" in -*|appman|apps|launcher|debug) _rest="$_rest $_a"; continue;; esac
				_pos="$_pos $_a"
			done
			# shellcheck disable=SC2086
			# (split intencionado: reconstruye posicionales)
			set -- $_pos
			_newsrc=""
			if [ $# -ge 2 ]; then
				_last=""; for _a in "$@"; do _last="$_a"; done
				case "$_last" in http://*|https://*) _is_src=1;; *)
					[ -f "$_last" ] && _is_src=1 || _is_src=0;; esac
				if [ "$_is_src" -eq 1 ]; then
					_newsrc="$_last"
					set -- "${@:1:$#-1}"
				fi
			fi
			if [ -n "$_newsrc" ] && [ $# -gt 1 ]; then
				_deapman_err "nuevo-origen solo vale con un objetivo: deapman update <nombre> [nuevo]"
				exit 2
			fi
			for _a in "$@"; do
				if _deapman_is_native "$_a"; then
					_deapman_update_one "$_a" "$_newsrc" || true
				else
					_rest="$_rest $_a"
				fi
			done
			# shellcheck disable=SC2086
			[ -n "$_rest" ] && _use_update update $_rest || true
		fi
		;;
	'dedup'|'thin')
		# Owned by deapman-dedup.am (re-delega con args intactos).
		MODULE="deapman-dedup.am"
		_use_module "$@"
		;;
	'verify')
		shift
		[ $# -ge 1 ] || { _deapman_err "uso: deapman verify <nombre|apodo>"; exit 2; }
		_deapman_verify "$1"
		;;
	'gc')
		shift
		_deapman_gc "$@"
		;;
	*)
		echo "$DIVIDING_LINE"
		echo $"ERROR: unknown option \"$1\", run the \"$AMCLI -h\" command to find out more" | _fit
		echo "$DIVIDING_LINE"
		exit 2
		;;
esac
